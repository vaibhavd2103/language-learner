# Free key from https://console.groq.com/keys (no credit card needed).
# You can also paste keys into the in-app Settings (gear icon) instead of using this file.
GROQ_API_KEY=

# Optional: natural German voice. Free plan has ~10k credits/month.
# https://elevenlabs.io/app/settings/api-keys
# If missing or out of credits, the app falls back to free Microsoft Edge neural voices.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional overrides
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo
