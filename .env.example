# Free key from https://console.groq.com/keys (no credit card needed)
GROQ_API_KEY=

# Optional overrides
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo

# --- German voice (pick one; if none is set, free Edge neural voices are used) ---
# ElevenLabs free plan (~10k credits/month): https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_MODEL=eleven_flash_v2_5   # eleven_multilingual_v2 sounds better but uses 2x credits
# Google Cloud TTS (Chirp 3 HD voices, ~1M chars/month free; needs a GCP project with billing enabled)
# GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE=de-DE-Chirp3-HD-Aoede
